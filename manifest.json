{
  "manifest_version": 3,
  "name": "YouTube Enhanced Search Filters",
  "version": "2.0.0",
  "description": "Combinable search filters for YouTube: date range, length, views, title words, channels, and hiding Shorts, ads and watched videos.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-enhanced-filters@DogeTennant",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/sp.js", "src/match.js", "src/panel.js", "src/content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
